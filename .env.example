# ============================================================
# SHARED ENV — copy to .env, fill in secrets, NEVER commit .env
# ============================================================

# --- Postgres (Supabase or Neon free tier) ---
# IMPORTANT: For cloud deployments (Modal, RunPod) connecting to Supabase, 
# you MUST use the IPv4 Connection Pooler URL (port 6543), not the direct IPv6 URL (port 5432).
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:password@aws-0-[region].pooler.supabase.com:6543/postgres
# --- Redis (Upstash free tier or local) ---
REDIS_URL=redis://localhost:6379/0
REDIS_TELEMETRY_QUEUE_KEY=telemetry:ingest
REDIS_JUNIOR_QUEUE_KEY=queue:junior
REDIS_SENIOR_QUEUE_KEY=queue:senior
REDIS_CONSENSUS_QUEUE_KEY=queue:consensus

# --- Object Storage (raw images / mask assets) ---
STORAGE_PROVIDER=local           # local | s3 | supabase_storage
STORAGE_BUCKET=rlhf-seg-images
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/static

# --- Service Ports (local dev) ---
PRE_INFERENCE_PORT=8001
ROUTING_QA_PORT=8002
SERVING_UI_PORT=8003          # Label Studio ML Backend
WEBHOOK_GATEWAY_PORT=8004
LABEL_STUDIO_PORT=8080

# --- Label Studio ---
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_TOKEN=changeme
LABEL_STUDIO_WEBHOOK_SECRET=changeme   # HMAC signature check in webhook_gateway
LABEL_STUDIO_ML_BACKEND_URL=http://serving_ui:8003

# --- Models / Compute ---
GROUNDING_DINO_CHECKPOINT=./models/groundingdino_swint_ogc.pth
SAM2_CHECKPOINT=./models/sam2_hiera_large.pt
DEVICE=cuda                    # cuda | cpu (use cpu for local dev without GPU)
MCD_FORWARD_PASSES=5

# --- Auth (MVP stub — replace before real deployment) ---
AUTH_MODE=header_stub          # header_stub | jwt
ANNOTATOR_ID_HEADER=X-Annotator-Id

# --- Feature Flags / Tuning ---
STOCHASTIC_AUDIT_RATE=0.05     # 5% forced consensus audit on "perfect" tasks
HONEYPOT_INJECTION_RATE=0.10
MAX_CONSENSUS_RETRIES=3
WIGGLE_SIGMA=0.02              # Gaussian variance for stochastic mask decoder

LOG_LEVEL=INFO
ENVIRONMENT=development
