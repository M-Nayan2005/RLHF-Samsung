# ============================================================
# SHARED ENV — copy to .env, fill in secrets, NEVER commit .env
# ============================================================

# --- Postgres (Supabase or Neon free tier) ---
# IMPORTANT: For cloud deployments (Modal, RunPod) connecting to Supabase, 
# you MUST use the IPv4 Connection Pooler URL (port 6543), not the direct IPv6 URL (port 5432).
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:password@aws-0-[region].pooler.supabase.com:6543/postgres
# --- Redis (Upstash free tier or local) ---
REDIS_URL=redis://localhost:6379/0
REDIS_TELEMETRY_QUEUE_KEY=telemetry:ingest
REDIS_JUNIOR_QUEUE_KEY=queue:junior
REDIS_SENIOR_QUEUE_KEY=queue:senior
REDIS_CONSENSUS_QUEUE_KEY=queue:consensus

# --- Object Storage (raw images / mask assets) ---
STORAGE_PROVIDER=local           # local | s3 | supabase_storage
STORAGE_BUCKET=rlhf-seg-images
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/static

# --- Service Ports (local dev) ---
PRE_INFERENCE_PORT=8001
ROUTING_QA_PORT=8002
SERVING_UI_PORT=8003          # Label Studio ML Backend
WEBHOOK_GATEWAY_PORT=8004
LABEL_STUDIO_PORT=8080

# --- Label Studio ---
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_TOKEN=changeme
LABEL_STUDIO_WEBHOOK_SECRET=changeme   # HMAC signature check in webhook_gateway
LABEL_STUDIO_ML_BACKEND_URL=http://serving_ui:8003

# --- Models / Compute ---
GROUNDING_DINO_CHECKPOINT=./models/groundingdino_swint_ogc.pth
SAM2_CHECKPOINT=./models/sam2_hiera_large.pt
DEVICE=cuda                    # cuda | cpu (use cpu for local dev without GPU)
MCD_FORWARD_PASSES=5

# --- Auth (MVP stub — replace before real deployment) ---
AUTH_MODE=header_stub          # header_stub | jwt
ANNOTATOR_ID_HEADER=X-Annotator-Id

# --- Feature Flags / Tuning ---
STOCHASTIC_AUDIT_RATE=0.05     # 5% forced consensus audit on "perfect" tasks
HONEYPOT_INJECTION_RATE=0.10
MAX_CONSENSUS_RETRIES=3
WIGGLE_SIGMA=0.02              # Gaussian variance for stochastic mask decoder

LOG_LEVEL=INFO
ENVIRONMENT=development

# ------------------------------------------------------------
# TRACK 3 — serving_ui
# ------------------------------------------------------------

# -- Upstream (Dev 2) and downstream (Dev 4) -----------------
# Not in the shared .env.example; serving_ui needs both to exist as names.
ROUTING_QA_URL=http://routing_qa:8002
WEBHOOK_GATEWAY_URL=http://webhook_gateway:8004
REQUEST_TIMEOUT_S=5.0

# Serve tests/mocks/routing_task.json instead of calling routing_qa. This is the
# "local testing without teammates" path from IMPLEMENTATION_PLAN.md §2.
# There is no automatic fallback to the fixture when routing_qa is down: a
# passing integration test against a fixture is worse than a failing one.
MOCK_MODE=false
MOCK_TASK_PATH=/app/tests/mocks/routing_task.json

# Which queue serving_ui claims from. The junior pool is the only one with a UI
# tonight; the senior and consensus pools are routed to and logged, no more.
JUNIOR_QUEUE_NAME=junior

# Label Studio does not forward an annotator identity to an ML backend, so this
# is what unidentified sessions are attributed to. Dev 2's trust scores are keyed
# on annotator_id, so leaving everyone as the default makes every annotator look
# like one person — see D16.
DEFAULT_ANNOTATOR_ID=annotator_unknown

# -- Stochastic policy ---------------------------------------
# affine (default, 5-dimensional action) | vertex (2N-dimensional).
# The spec requires a low-dimensional action space so the critic can assign
# credit (Fault 2), which is why affine is the default. See DD-2.
WIGGLE_MODE=affine

# What WIGGLE_SIGMA is a fraction OF.
#   bbox_diagonal — Grounding DINO's box from the QueueTask (default)
#   mask_diagonal — the polygon's own extent
# sigma=0.02 then means "roughly 2% of the object's diagonal" per action
# dimension. The spec does not say; recorded as D14 / Q14.
WIGGLE_SCALE_REFERENCE=bbox_diagonal

# Keep wiggled vertices inside the image. Label Studio silently DISCARDS a
# region with out-of-range coordinates, so turning this off near an image edge
# costs the whole pre-annotation.
WIGGLE_CLAMP_TO_FRAME=true
WIGGLE_SEED_BYTES=16

SERVING_UI_MODEL_VERSION=serving-ui-stochastic-0.1.0

# -- Image geometry ------------------------------------------
# QueueTask carries no image dimensions, but Label Studio polygons are
# percentages, so they have to come from somewhere (divergence D12).
#   probe — read them from the image header (default)
#   fixed — always use the defaults below
#
# With IMAGE_DIM_SOURCE=probe, a FAILED probe does NOT fall back to the defaults
# below — the task is served without a pre-annotation instead. Nobody chose those
# numbers for that image, and a wrong-scale mask is worse than none: the
# annotator corrects it anyway and the telemetry then describes a polygon the
# policy never proposed. Set IMAGE_DIM_SOURCE=fixed to opt in deliberately.
IMAGE_DIM_SOURCE=probe
DEFAULT_IMAGE_WIDTH=1920
DEFAULT_IMAGE_HEIGHT=1080
IMAGE_PROBE_TIMEOUT_S=3.0

# -- Locally served images -----------------------------------------
# serving_ui serves this directory at ASSETS_URL_PREFIX, and reads images under
# that prefix straight off disk rather than fetching its own socket.
#
# Useful for local verification: an `image_url` of
# http://localhost:8003/assets/test.jpg is loadable by the browser AND probeable
# by this service, with no TLS and no Label Studio auth in the way. The first
# public image tried (images.cocodataset.org) fails certificate verification in
# both httpx and curl, so a local copy avoids that entirely.
#
# Only this directory is exposed. Do NOT point it at tests/, which holds the
# hand-dropped Label Studio API token during setup.
ASSETS_DIR=/app/tests/assets
ASSETS_URL_PREFIX=/assets/

# -- Label Studio wiring -------------------------------------
# These must match label_studio/labeling_config.xml. serving_ui parses the live
# config out of each /predict call and prefers what it finds there, so these are
# only the fallback for when Label Studio omits it.
LS_FROM_NAME=polygon
LS_TO_NAME=image
LS_LABEL_FALLBACK=object
LS_PROJECT_TITLE="RLHF Segmentation - Junior Pool"

# -- Served-wiggle store (Q11 / D10) -------------------------
# The polygon actually shown to the human — the sampled action A_t. The frozen
# contracts persist only wiggle_seed, which makes A_t reconstructible but not
# stored. See services/serving_ui/app/store.py.
SERVED_STORE_BACKEND=jsonl
SERVED_STORE_PATH=/app/data/served_wiggles.jsonl

# -- Telemetry -----------------------------------------------
#   beacon  — browser POSTs to serving_ui /telemetry/raw, which forwards to the
#             gateway. THE IMPLEMENTED DEFAULT. See DD-4.
#   ls_meta — rewrite the annotation POST body to carry meta.effort_telemetry.
#             Best-effort; depends on the Label Studio version persisting it.
#   both    — do both, and let Dev 4 deduplicate on annotation_id.
TELEMETRY_TRANSPORT=beacon
TELEMETRY_FORWARD_ENABLED=true

# Origins allowed to POST telemetry. Defaults to LABEL_STUDIO_URL plus its
# localhost spellings; set explicitly when annotators reach the proxy by
# hostname. Comma-separated.
# CORS_ALLOW_ORIGINS=http://localhost:8081

# -- Injection proxy (browser-facing; resolved by the annotator's browser) ----
RLHF_TELEMETRY_ENDPOINT=http://localhost:8003/telemetry/raw
RLHF_TELEMETRY_SCRIPT_URL=http://localhost:8003/static/effort_telemetry.js
RLHF_TELEMETRY_DEBUG=false
